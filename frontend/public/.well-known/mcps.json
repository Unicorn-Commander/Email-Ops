{
  "$schema": "https://brigade.unicorncommander.ai/.well-known/mcps-schema-v1.json",
  "name": "Email-Ops",
  "version": "0.1.0",
  "description": "Privacy-first email cockpit: connected mailboxes, threads, the agent-inbox approval surface, mail triage, conversational provisioning, the Cleaner engine, and an agent-controls-the-UI (AG-UI) surface — over the Stalwart mail engine.",
  "mcp_endpoint": "https://email-ops.magicunicorn.dev/api/v1/mcp",
  "tool_namespace": "emailops",
  "auth": {
    "type": "keycloak_jwt",
    "federated_auth": {
      "type": "brigade_jwt",
      "trusted_issuer": "https://brigade.unicorncommander.ai",
      "jwks_url": "https://brigade.unicorncommander.ai/.well-known/jwks.json",
      "expected_audience": "email-ops",
      "signing_algorithm": "RS256"
    }
  },
  "tools": [
    {
      "name": "health",
      "description": "Liveness + configuration check. Returns service status, whether suite tenancy is enabled, and the server time.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "list_my_workspaces",
      "description": "Return the workspaces the calling user is an active member of, with their canonical suite role and which one is the default. Empty when the user has no membership.",
      "input_schema": {
        "type": "object",
        "properties": {
          "_ack": {
            "type": "boolean"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:workspaces"
      ],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "email_ops_health",
      "description": "The email operations health + setup report for a workspace: is the mail engine configured, the default mailbox + mailbox count, the approval-queue backlog (pending count + oldest age), failed sends in the last 7 days, and the registered agent fleet (count + how many can send autonomously). Read-only — a Mail-Ops steward calls this to know the setup and run health checks.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:email"
      ],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "list_agents",
      "description": "List the workspace’s registered agents (the registry): each agent’s stable key, display name, sending mailbox, autonomy level (L0/L1/L2), and how many of its drafts await approval. Read-only — the fleet roster a Mail-Ops steward reads.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:agents"
      ],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "provision_mailbox",
      "description": "Create a mailbox (human / agent / shared) by talking to an agent. Runs AS the calling user: the workspace provisioning policy is enforced with the user’s own role — so this only does what that user is allowed to. Returns {status:\"created\", mailbox} when applied, or {status:\"pending_approval\", request} when the policy requires an approver (a human approves it in the Mailboxes view). owner_kind AGENT is the higher-trust send-identity path (admin by default).",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "email_address": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "owner_kind": {
            "type": "string",
            "enum": [
              "HUMAN",
              "AGENT",
              "SHARED"
            ]
          },
          "owner_key": {
            "type": "string"
          }
        },
        "required": [
          "email_address"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:mailboxes"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "provision_agent",
      "description": "Register a new agent (key + display name + autonomy + tier + manager) by talking to an agent. Runs AS the calling user with their role enforced against the provisioning policy. Returns {status:\"created\", agent} or {status:\"pending_approval\", request}. autonomy_level ∈ L0_DRAFT_ONLY|L1_APPROVE_TO_SEND|L2_AUTONOMOUS_AUDIT; tier ∈ EXECUTIVE|DOMAIN_LEAD|MANAGER|SPECIALIST|UNSPECIFIED.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "autonomy_level": {
            "type": "string",
            "enum": [
              "L0_DRAFT_ONLY",
              "L1_APPROVE_TO_SEND",
              "L2_AUTONOMOUS_AUDIT"
            ]
          },
          "tier": {
            "type": "string",
            "enum": [
              "EXECUTIVE",
              "DOMAIN_LEAD",
              "MANAGER",
              "SPECIALIST",
              "UNSPECIFIED"
            ]
          },
          "manager_agent_key": {
            "type": "string"
          },
          "mailbox_account_id": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "display_name"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:agents"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "set_disposition",
      "description": "Triage a thread into a folder by talking to an agent: INBOX (un-triage), ARCHIVE, TRASH, or SPAM (junk). Runs AS the calling user; only works in a workspace they are a member of. This is the agent analogue of the human triage UI — an agent on a loop can archive handled threads or route junk to Spam. Returns the updated disposition overlay row.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          },
          "disposition": {
            "type": "string",
            "enum": [
              "INBOX",
              "ARCHIVE",
              "TRASH",
              "SPAM"
            ]
          }
        },
        "required": [
          "thread_id",
          "disposition"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:triage"
      ],
      "tier_required": "free",
      "read_only": false
    },
    {
      "name": "set_sender_policy",
      "description": "Add/update a sender block (BLOCK) or trust (ALLOW) rule — an exact ADDRESS or a whole DOMAIN. The app enforces it on triage today and feeds it to the mail engine’s inbound spam filter once live (BLOCK → Spam; ALLOW → never-spam). Runs AS the calling user, member-level. Upserts on (scope, pattern).",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "ADDRESS",
              "DOMAIN"
            ]
          },
          "pattern": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "BLOCK",
              "ALLOW"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "pattern",
          "kind"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:triage"
      ],
      "tier_required": "free",
      "read_only": false
    },
    {
      "name": "list_threads_with_contact",
      "description": "List the mailbox THREADS with a customer’s contact (the customer-360 email history). Federated from the Stalwart mailbox + the workspace’s own outbound SoR rows, deduped by thread. Read-only / viewer-level — does NOT require the dual SKU. Returns { threads: [...] }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "contact_id": {
            "type": "string"
          }
        },
        "required": [
          "contact_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:email"
      ],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "list_thread_messages",
      "description": "List the MESSAGES in one thread, bodies as PREVIEWS only (the full message lives in Stalwart). Read-only / viewer-level. Returns { messages: [...] }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string"
          }
        },
        "required": [
          "thread_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:email"
      ],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "compose_email",
      "description": "Compose an outbound email to a customer’s contact. mode=send queues delivery now (Stalwart, or Postmark for the transactional high-rep lane); mode=draft stages it into the AGENT INBOX approval surface (a human approves before it leaves — the safe default for an agent). IDEMPOTENT on (workspace_id, external_source, external_ref): a repeat returns the EXISTING message and queues NO second send. Requires BOTH customer-ops and email-ops entitlements. Email-Ops stores no contact record (contact_id is a thin reference) and is the system-of-record for the message it created.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "contact_id": {
            "type": "string"
          },
          "to_address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 320
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "mode": {
            "type": "string",
            "enum": [
              "send",
              "draft"
            ]
          },
          "in_reply_to_thread_id": {
            "type": "string",
            "maxLength": 200
          },
          "external_source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "external_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "to_address",
          "subject",
          "body",
          "external_source",
          "external_ref"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:email"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "list_connected_accounts",
      "description": "List whether the caller has linked Gmail or Microsoft in Keycloak. Viewer-level; no SKU gate. Returns { accounts: [{ provider, linked }] }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:accounts"
      ],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "get_inbox_stats",
      "description": "Return Cleaner Engine inbox stats using the caller’s brokered provider token. Requires the email-ops SKU.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:cleaner"
      ],
      "tier_required": "pro",
      "read_only": true
    },
    {
      "name": "analyze_inbox",
      "description": "Run the stateless Cleaner Engine analysis using the caller’s brokered provider token. Requires the email-ops SKU.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:cleaner"
      ],
      "tier_required": "pro",
      "read_only": true
    },
    {
      "name": "plan_cleanup",
      "description": "Build a dry-run cleanup plan with protected and safe rows separated. Read-only preview; does not mutate the mailbox.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          },
          "criteria": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:cleaner"
      ],
      "tier_required": "pro",
      "read_only": true
    },
    {
      "name": "clean_trash",
      "description": "Stage a trash cleanup batch into the agent inbox. The caller is an agent, so this does not execute immediately.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          },
          "criteria": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:cleaner"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "clean_delete",
      "description": "Stage a permanent-delete cleanup batch into the agent inbox. Human approval later enforces the verified-backup gate.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          },
          "criteria": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:cleaner"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "organize_messages",
      "description": "Stage an organize/archive batch into the agent inbox. This is a pending approval request for an agent caller.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          },
          "criteria": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:cleaner"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "unsubscribe_sender",
      "description": "Stage an unsubscribe batch into the agent inbox for a sender group. Approval later decides whether it executes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          },
          "sender_group": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "provider",
          "sender_group"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:cleaner"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "undo_batch",
      "description": "Undo a cleanup batch record. This is a best-effort audit reversal and does not invent a restore path the engine does not expose.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "enum": [
              "gmail",
              "microsoft"
            ]
          },
          "batch_id": {
            "type": "string"
          }
        },
        "required": [
          "provider",
          "batch_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:cleaner"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "list_agent_inbox",
      "description": "List the agent-inbox queue: agent-drafted messages awaiting human approval before send (mode=draft composes land here). Defaults to PENDING; pass state to filter. Returns { items: [...], count }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "read:agent_inbox"
      ],
      "tier_required": "free",
      "read_only": true
    },
    {
      "name": "approve_agent_inbox_item",
      "description": "Approve a PENDING agent-inbox draft: hand it to the send lane and advance the message to queued/sent. This is the human-in-the-loop SEND, so it requires BOTH customer-ops and email-ops entitlements. Returns the updated inbox item + message.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:agent_inbox"
      ],
      "tier_required": "pro",
      "read_only": false
    },
    {
      "name": "reject_agent_inbox_item",
      "description": "Reject a PENDING agent-inbox draft: mark it REJECTED; the message is never sent. Returns the updated inbox item + message.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "item_id": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "item_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "write:agent_inbox"
      ],
      "tier_required": "free",
      "read_only": false
    },
    {
      "name": "ui_navigate",
      "description": "Push a NAVIGATE command to the calling user’s open Email-Ops cockpit: route it to an app path (e.g. /mail, /agents, /agent-inbox, /cleanup, /dashboard, /insights, /mailboxes, /accounts). Applied on the user’s next focus-gated poll. No side effect. Returns { enqueued, command_id, kind }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "control:ui"
      ],
      "tier_required": "free",
      "read_only": false
    },
    {
      "name": "ui_open_thread",
      "description": "Push an OPEN_THREAD command: navigate the user’s cockpit to /mail and select a specific thread (optionally selecting its mailbox first). Read-only UI action. Returns { enqueued, command_id, kind }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "mailbox_id": {
            "type": "string"
          },
          "thread_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "thread_id"
        ],
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "control:ui"
      ],
      "tier_required": "free",
      "read_only": false
    },
    {
      "name": "ui_compose",
      "description": "Push a COMPOSE command that opens the cockpit composer PRE-FILLED with an optional to / subject / body (and optional thread to reply in). It does NOT send — the human reviews and sends. Use compose_email instead to actually queue/stage an outbound message. Returns { enqueued, command_id, kind }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string"
          },
          "to": {
            "type": "string",
            "maxLength": 320
          },
          "subject": {
            "type": "string",
            "maxLength": 500
          },
          "body": {
            "type": "string",
            "maxLength": 100000
          },
          "thread_id": {
            "type": "string",
            "maxLength": 200
          }
        },
        "additionalProperties": false,
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "scopes_required": [
        "control:ui"
      ],
      "tier_required": "free",
      "read_only": false
    },
    {
      "name": "ui_switch_space",
      "description": "Push a SWITCH_SPACE command: set the cockpit’s active Space (a Space id, or \"all\" for no filter), which re-scopes /mail + the agents view. Returns { enqueued, command_id, kind }.",
      "input_schema": {
        "type": "object",
        "properties": {
          "workspace_id": {
