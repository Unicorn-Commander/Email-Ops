# =====================================================================
# Email-Ops — Backend environment template
# Copy to .env and fill in. Never commit .env.
# =====================================================================

# --- Database ---
# Runtime connects as the OBJECT OWNER in Phase 1 (RLS created-but-inert).
# A LATER phase flips this to the NOBYPASSRLS `email_ops_app` role to make the
# tenant fence live. See infrastructure/database/init/01-init.sql + the RLS
# migration for the role split.
DATABASE_URL=postgresql://email_ops_admin:REMOVED@email-ops-postgres:5432/emailops?schema=public
# Admin/DDL connection used for migrations (owner role). Optional in dev.
ADMIN_DATABASE_URL=postgresql://email_ops_owner:REMOVED@email-ops-postgres:5432/emailops?schema=public

# --- Application ---
NODE_ENV=production
PORT=3231
API_PREFIX=api/v1
LOG_LEVEL=info

# --- Public base URL (absolute links in outbound mail) ---
# The absolute origin the public app is served from. Generated agent signatures
# embed the agent avatar as an ABSOLUTE URL (<base>/agent-avatars/<key>.svg) —
# a mail client has no origin to resolve a relative path against. Optional;
# defaults to https://email-ops.magicunicorn.dev when unset.
EMAIL_OPS_PUBLIC_BASE_URL=https://email-ops.magicunicorn.dev

# --- JWT (local sessions issued after the Keycloak OIDC callback) ---
# Generate: openssl rand -base64 64
JWT_SECRET=[GENERATE_64_BYTE_SECRET]
JWT_EXPIRES_IN=1d

# --- CORS / Frontend URL ---
CORS_ORIGIN=https://emailops.unicorncommander.ai
FRONTEND_URL=https://emailops.unicorncommander.ai

# --- Keycloak SSO (uchub realm on auth.unicorncommander.ai) ---
# aud=email-ops (SUITE-IDENTITY §1: every app sets its own audience).
KEYCLOAK_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_CLIENT_ID=email-ops
KEYCLOAK_CLIENT_SECRET=[FROM_KEYCLOAK_ADMIN_CLIENT_CREDENTIALS]
KEYCLOAK_CALLBACK_URL=/api/v1/auth/keycloak/callback
# MCP realm-token audience migration. Accepted values are KEYCLOAK_CLIENT_ID
# plus this comma-separated list, matched against `aud` OR `azp`. Keep false
# for the evidence window; true rejects tokens that match neither value.
KEYCLOAK_EXPECTED_AUDIENCES=
KEYCLOAK_ENFORCE_AUDIENCE=false

# Browser origins allowed to call the streamable MCP route. CORS_ORIGIN and
# FRONTEND_URL above are included automatically; add comma-separated origins
# here for an additional MCP client UI.
MCP_CORS_ORIGINS=

# --- Brigade federation (RS256; SUITE-IDENTITY §1/§D6) ---
# Comma-separated trusted issuer base URLs. Each issuer's JWKS is read from
# `<iss>/.well-known/jwks.json`. Set to "" to disable the federation branch.
# A Brigade token's `aud` MUST equal BRIGADE_EXPECTED_AUDIENCE (email-ops) or it
# is rejected even when its signature + issuer verify.
BRIGADE_TRUSTED_ISSUERS=https://brigade.unicorncommander.ai
BRIGADE_EXPECTED_AUDIENCE=email-ops

# --- Suite tenancy (SUITE-IDENTITY) ---
# Master switch. DEFAULT OFF == current behavior: workspace routes do NOT
# require a Membership row, the membership gate is a no-op, rows resolve to
# DEFAULT_WORKSPACE_ID, and the DB RLS is inert because the runtime still
# connects as the table owner. Flip to true (alongside pointing DATABASE_URL at
# the NOBYPASSRLS email_ops_app role) to make the fence live.
EMAIL_OPS_TENANCY_ENABLED=false

# The single bootstrap/dogfood workspace id seeded by the RLS migration.
# uc-registry owns real workspace ids in production; Email-Ops NEVER mints.
DEFAULT_WORKSPACE_ID=0190a000-7e57-7000-8000-00000000e001

# SSO access list — "who can sign into Email-Ops + at what role on JIT".
# Comma-separated `email-or-pattern:role`. Roles: OWNER|ADMIN|MANAGER|MEMBER|VIEWER.
EMAIL_OPS_ACCESS_LIST="aaron@magicunicorn.tech:OWNER,shafenkhan@users.noreply.github.com:OWNER,*@magicunicorn.tech:MEMBER"

# --- Stalwart mail engine (the mailbox read path; SUITE-ARCHITECTURE-MAP §3) ---
# Email-Ops FRONTS the Stalwart mail server (IMAP/JMAP) for mailbox state +
# threads. The read path (list threads/messages) is JMAP. Leave both
# STALWART_JMAP_URL and STALWART_IMAP_HOST UNSET to run degrade-clean: mailbox
# reads return empty + sends record FAILED, while the agent-inbox + the message
# SoR still work (so Email-Ops runs without a live mail server — verification,
# or any node where Stalwart isn't reachable).
STALWART_JMAP_URL=
STALWART_JMAP_TOKEN=
STALWART_IMAP_HOST=
STALWART_IMAP_PORT=993
STALWART_SMTP_HOST=
STALWART_SMTP_PORT=587
# Mail engine call timeout (ms); default 10000.
STALWART_TIMEOUT_MS=10000

# --- Davis calendar (Phase 2b) ---
# The CalDAV base URL is used for both normal calendar calls and the one-time
# device setup dialog. Leave bridge values empty to keep production access
# fail-closed until the private tailnet sidecar is deployed.
DAVIS_CALDAV_URL=https://calendar.unicorncommander.ai/dav
CALENDAR_SERVER_URL=https://calendar.unicorncommander.ai/dav
CALENDAR_BRIDGE_URL=
CALENDAR_BRIDGE_TOKEN=
# Keep this short; the bridge itself applies the hard timeout ceiling.
CALENDAR_BRIDGE_TIMEOUT_MS=5000

# --- Cleaner Engine (external connected-account analysis service) ---
# Stateless HTTP service for connected external email accounts. Leave unset to
# keep connected-account stats/analyze degrade-clean. The app owns the encrypted
# credential vault and passes credentials on every request.
CLEANER_ENGINE_URL=
CLEANER_ENGINE_TOKEN=
CLEANER_ENGINE_TIMEOUT_MS=10000
# Base64-encoded 32-byte AES-GCM key for encrypting OAuth credentials at rest.
CONNECTED_ACCOUNT_ENC_KEY=

# --- Postmark (transactional OUTBOUND lane; the high-rep lane) ---
# Transactional sends route via Postmark per the suite comms lanes (a cold-lead
# spam complaint must never touch invoice/transactional deliverability). When
# unset, transactional sends fall back to Stalwart submission. From must be a
# Postmark-signed sender (see the Postmark From rule in ops notes).
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# compose_email attachment policy. Values are bytes for the two size caps and
# comma-separated filename extensions or MIME tokens for the allow-list.
EMAIL_OPS_ATTACHMENT_MAX_FILES=5
EMAIL_OPS_ATTACHMENT_MAX_FILE_BYTES=10485760
EMAIL_OPS_ATTACHMENT_MAX_TOTAL_BYTES=20971520
EMAIL_OPS_ATTACHMENT_ALLOWED_TYPES=pdf,png,jpg,txt,csv,md,docx,xlsx

# --- Inbound engagement webhooks (Phase 2, Part A) ---
# Master switch for POST /webhooks/postmark. DEFAULT OFF == today's behavior: the
# route exists but is NEVER open — it returns 503 so a forged or premature call
# does nothing and no engagement is captured. Flip to true AND set
# POSTMARK_WEBHOOK_SECRET to make the receiver live.
EMAIL_WEBHOOKS_ENABLED=false
# The shared secret Postmark must present to authenticate the webhook. Configure
# Postmark's webhook URL with HTTP Basic creds (https://hook:<secret>@host/...)
# OR send it as `X-Postmark-Webhook-Token: <secret>`. Generate: openssl rand -hex 32.
# When unset the route stays 503 even if EMAIL_WEBHOOKS_ENABLED=true (fail-closed:
# no credential to verify against → refuse, never accept a forgeable call).
POSTMARK_WEBHOOK_SECRET=

# --- Inbound watcher + agent-reply runtime (the agent-email fabric) ---
# INBOUND_WATCHER_ENABLED: master switch for the per-mailbox JMAP delta poll
# that classifies newly-arrived sovereign mail (sender-policy + spam →
# disposition) and routes AGENT-mailbox arrivals to the reply seam. DEFAULT OFF
# == today's behavior (the watcher deploys DORMANT; enable + verify deliberately).
INBOUND_WATCHER_ENABLED=false
# AGENT_REPLY_RUNTIME_ENABLED: when a watched AGENT mailbox receives mail, draft
# a reply via the Cleaner Engine LLM (/ai/chat) and stage it into the
# agent-inbox approval queue. NEVER auto-sends — every draft awaits a human
# approve, at every autonomy level. Needs INBOUND_WATCHER_ENABLED=true (the
# watcher is its only caller) + CLEANER_ENGINE_URL/TOKEN (else it degrades to a
# debug log). DEFAULT OFF (dormant-seam posture).
AGENT_REPLY_RUNTIME_ENABLED=false

# --- Compose entitlement gate (cross-app dual-SKU; SUITE-IDENTITY) ---
# SENDING/DRAFTING outbound mail via Email-Ops requires BOTH `customer-ops` AND
# `email-ops` on the caller's entitlements. Reads (list threads/messages) are
# viewer-level (no dual SKU). Until Lago emits the claim, set `open` to allow the
# gate to run with a loud WARN (pre-Lago bootstrap); flip to `enforce` once
# entitlements are emitted + verified. UC_ENTITLEMENT_MODE wins, falling back to
# EMAIL_OPS_CROSS_APP_ENTITLEMENT_MODE. Default (unset) = enforce.
UC_ENTITLEMENT_MODE=open
