generator client {
  provider      = "prisma-client-js"
  // Pin engines so a slim build image (no libssl at generate time) still ships
  // the OpenSSL 3.0 query engine the bookworm runtime needs. Without this,
  // generate falls back to debian-openssl-1.1.x and the client fails to boot.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Email-Ops — the mailbox / thread surface + the agent-inbox
// approval surface of the Unicorn Commander suite.
//
// THE GOLDEN RULE (SUITE-ARCHITECTURE-MAP §2/§3): Email-Ops is the
// APP that FRONTS the Stalwart mail server (IMAP/JMAP) for mailbox
// state + threads, and is the system-of-record for every mailbox,
// thread, and outbound message IT initiated. It "federates the
// engine, doesn't reinvent a mail server": Stalwart runs the
// mailboxes; transactional outbound routes via Postmark (the
// high-rep deliverability lane). Email-Ops owns the AGENT INBOX (the
// human-in-the-loop approval queue for agent-drafted mail) outright.
//
// Customer-Ops (and any cockpit) FEDERATES Email-Ops over MCP by
// workspace_id — it never runs a mail server, never stores a message
// body, never copies a thread. The contract Email-Ops implements
// (the 3 tools) is mirrored from Customer-Ops backend/src/email-ops/
// (EmailOpsPort / email-ops.types.ts) so the cockpit calls us for real.
//
// PHASE 1 (this layer) = the tenancy FOUNDATION (Workspace+Membership
// tenancy boundary per SUITE-IDENTITY §2, SSO identity, RLS + the
// 4-role split + current_workspace_id() GUC + withWorkspace(), the
// Keycloak auth aud=email-ops membership-gated, the StalwartPort +
// degrade-clean client, the EmailOpsPort contract MCP server, and the
// agent-inbox). RLS is ENABLE+FORCE-d on every scoped table; the fence
// goes live the moment the runtime DATABASE_URL flips to the
// NOBYPASSRLS email_ops_app role.
// ============================================================

// ============================================================
// ENUMS
// ============================================================

// ── Suite tenancy (SUITE-IDENTITY.md §2 / §7) ────────────
//
// The canonical suite roles + membership lifecycle. Roles rank
// viewer < member < manager < admin < owner (SUITE-IDENTITY §7).
enum WorkspaceRole {
  VIEWER
  MEMBER
  MANAGER
  ADMIN
  OWNER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

// ── Outbound message lane (Email-Ops OWNS this) ──
//
// The compose lane selected by the cockpit / an agent:
//   - SEND  : queue it for delivery now (Email-Ops → Stalwart/Postmark).
//   - DRAFT : stage it into the agent-inbox approval surface; a human
//             approves before it leaves.
enum EmailMode {
  SEND
  DRAFT
}

// ── Outbound message lifecycle (Email-Ops OWNS this) ──
//
// The status the cockpit caches on its thin link. QUEUED→SENT→DELIVERED is
// the send lane; DRAFT→PENDING_APPROVAL→(approve)→QUEUED is the agent-inbox
// lane; FAILED is terminal-error; REJECTED is a human declining a draft.
// BOUNCED is the engine reporting a hard/soft bounce post-send (Postmark Bounce
// webhook) — a terminal deliverability failure distinct from a pre-send FAILED.
//
// MONOTONIC ORDER (the webhook status ladder, Part A): a later engagement event
// must never REGRESS the row to an earlier rung. The send/delivery progression
// is QUEUED(0) < SENT(1) < DELIVERED(2); BOUNCED/FAILED/REJECTED are terminal
// off-ramps that always win once set. The webhook updater consults this rank so
// an out-of-order Postmark re-delivery (e.g. an Open arriving before the
// Delivery it implies) cannot pull DELIVERED back down to SENT.
enum EmailMessageStatus {
  QUEUED
  SENT
  DELIVERED
  DRAFT
  PENDING_APPROVAL
  REJECTED
  FAILED
  BOUNCED
}

// ── Message direction within a mailbox (Email-Ops OWNS this) ──
enum EmailDirection {
  RECEIVED
  SENT
  DRAFT
}

// ── Mailbox disposition / folder (Email-Ops OWNS this — the app-layer overlay) ──
//
// A thread's folder placement as an OVERLAY over the federated mailbox, NOT a
// fork of the engine's state. INBOX is the implicit default (no row). ARCHIVE /
// TRASH / SPAM are explicit user/agent triage. When the mail engine is live this
// overlay is the source the JMAP-keyword / Junk-mailbox sync reconciles toward;
// until then it is the whole truth for the SoR rows we hold. SPAM is the app-side
// Junk verdict — distinct from the engine's inbound spam SCORE (see EmailMessage
// .spamScore/.spamVerdict, stamped by the SpamPort when the engine produces one).
enum MessageDisposition {
  INBOX
  ARCHIVE
  TRASH
  SPAM
}

// ── Sender allow/block policy (Email-Ops OWNS this) ──
//
// A per-workspace block/allow list the app enforces on display + triage and
// FEEDS the mail engine's inbound filter once live (the engine is the real gate;
// this is the policy the app teaches it). BLOCK → route to Spam; ALLOW → trusted
// / never-spam. Scope is an exact ADDRESS or a whole DOMAIN.
enum SenderPolicyKind {
  BLOCK
  ALLOW
}

enum SenderPolicyScope {
  ADDRESS
  DOMAIN
}

// ── SMS channel (the enterprise/shared-line scope; Email-Ops OWNS this) ──
//
// The SMS send/draft analogue of EmailMode/EmailMessageStatus. Dedicated (not the
// Email* enums) so the SMS channel is self-contained. The agent-inbox approval
// queue, the autonomy dial, the kill switch, and the audit log are SHARED — an SMS
// send flows through the exact same governance as email.
enum SmsMode {
  SEND
  DRAFT
}

enum SmsDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  PENDING_APPROVAL
  REJECTED
  FAILED
}

// ── Agent-inbox approval state (Email-Ops OWNS this) ──
//
// The lifecycle of an agent-drafted message awaiting human approval before
// send. PENDING is the default a mode=draft compose lands at; APPROVED means a
// human approved it and it was handed to the send lane; REJECTED means a human
// declined it (it never leaves). One inbox item per outbound DRAFT message.
enum AgentInboxState {
  PENDING
  APPROVED
  REJECTED
}

enum AgentInboxKind {
  EMAIL
  CLEANUP
}

// ── Agent autonomy dial (Email-Ops OWNS this) ──
//
// The per-agent send-autonomy level the registry carries (the "autonomy dial"):
//   L0_DRAFT_ONLY       — stage drafts only; never sends, even autonomously.
//   L1_APPROVE_TO_SEND  — drafts; a human approves each send (today's default flow).
//   L2_AUTONOMOUS_AUDIT — may send without per-message approval; every send audited.
// This layer RECORDS + manages the dial; enforcement in the compose/approve path
// is a follow-up that reads this value (so L2 is not auto-sending yet).
enum AgentAutonomyLevel {
  L0_DRAFT_ONLY
  L1_APPROVE_TO_SEND
  L2_AUTONOMOUS_AUDIT
}

// ── Agent-mail action/audit event (Email-Ops OWNS this) ──
//
// The audit substrate behind the activity feed + the "autonomous-with-audit"
// guarantee. One row per governance-relevant agent-mail action:
//   AUTONOMOUS_SEND     — an L2 agent sent without human approval.
//   STAGED_FOR_APPROVAL — an agent draft staged (incl. a send coerced by the dial).
//   APPROVED / REJECTED — a human decided a staged draft.
//   PAUSED / RESUMED    — the workspace kill switch was toggled.
enum AgentActionKind {
  AUTONOMOUS_SEND
  STAGED_FOR_APPROVAL
  APPROVED
  REJECTED
  PAUSED
  RESUMED
  // Provisioning + fleet-management actions (the command-center plane).
  MAILBOX_CREATED
  MAILBOX_UPDATED
  MAILBOX_ACCESS_GRANTED
  MAILBOX_ACCESS_REVOKED
  AGENT_CREATED
  AGENT_UPDATED
  AUTONOMY_CHANGED
  PROVISION_REQUESTED
  PROVISION_APPROVED
  PROVISION_REJECTED
  PROVISION_APPLIED
  PROVISION_FAILED
}

// ── Mailbox ownership + agent access (the command-center plane) ──
//
// A mailbox's PRINCIPAL (who it belongs to) is distinct from which agents may
// ACT THROUGH it (AgentMailbox). ownerKind=SHARED is the back-compat default for
// every pre-existing workspace mailbox.
enum MailboxOwnerKind {
  HUMAN
  AGENT
  SHARED
}

// What an agent may DO through a mailbox it's bound to.
enum MailboxAccessLevel {
  SEND
  READ
  BOTH
}

// SoR-row vs a real engine-minted account. PROVISIONED only once the mail engine
// mints the actual IMAP/JMAP account; until then the row is REGISTERED (honest —
// no fiction while the engine is dormant).
enum MailboxProvisionState {
  REGISTERED
  PROVISIONING
  PROVISIONED
  PROVISION_FAILED
}

// The agent's org-chart rank (a thin denormalized copy of the Brigade hierarchy;
// UNSPECIFIED = lowest privilege to any tier-aware policy).
enum AgentTier {
  EXECUTIVE
  DOMAIN_LEAD
  MANAGER
  SPECIALIST
  UNSPECIFIED
}

// The provisioning policy dial per action: OPEN (any member) / MANAGER / ADMIN_ONLY
// / APPROVAL (anyone may request, an approver applies).
enum ProvisioningMode {
  OPEN
  MANAGER
  ADMIN_ONLY
  APPROVAL
}

enum ProvisionableKind {
  HUMAN_MAILBOX
  AGENT_MAILBOX
  AGENT
}

enum ProvisioningRequestState {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  APPLIED
  FAILED
}

enum CleanupActionKind {
  TRASH
  DELETE
  ORGANIZE
  UNSUBSCRIBE
  UNDO
}

enum CleanupBatchState {
  PENDING
  COMPLETED
  REJECTED
  FAILED
  UNDONE
  CANCELED
}

// ── Normalized engagement vocabulary (Email-Ops OWNS the capture) ──
//
// The suite's normalized engagement vocabulary (SUITE contract / Customer-Ops'
// EngagementKind / the suite OutreachEngagementKind): the 5 lowercase kinds a
// downstream cockpit reads. Captured from the mail engine's delivery/engagement
// webhooks (Postmark today) and persisted on EmailEngagementEvent. The WIRE
// vocabulary is exactly these 5 lowercased values; this enum is the storage
// shape. `REPLIED` is reserved (a reply is surfaced from the inbound thread, not
// a Postmark engagement record) so the captured set stays a strict subset.
enum EmailEngagementKind {
  REPLIED
  CLICKED
  OPENED
  BOUNCED
  UNSUBSCRIBED
}

// ============================================================
// SUITE TENANCY (SUITE-IDENTITY.md §2 — VERBATIM)
// ============================================================
//
// Phase 1 of the suite tenancy foundation. These two models + a
// `workspaceId` on every tenant-scoped model land the DB-enforced
// tenancy boundary. RLS is created-and-FORCED by the migration but
// inert for the running app until the runtime DATABASE_URL is flipped
// to the NOBYPASSRLS `email_ops_app` role (a later phase). Nothing
// here changes the running app's default behavior.

/// Thin mirror of the uc-registry workspace record. Email-Ops NEVER mints workspace_id.
model Workspace {
  id                String                 @id // == uc-registry workspace_id (uuidv7). NO @default.
  slug              String                 @unique
  displayName       String
  parentWorkspaceId String?
  isolationMode     String                 @default("standard") // 'strict'|'standard'|'open'  (TEXT+CHECK, §5)
  isolationTier     String                 @default("shared") // 'shared'|'premium'|'enterprise'|'dedicated'
  hipaaMode         Boolean                @default(false)
  gdprMode          Boolean                @default(false)
  dataResidency     String?                @default("us-east")
  status            String                 @default("active") // active|suspended|archived|deleting
  // Kill switch: when true, agents cannot compose/send mail in this workspace
  // (a human approving an already-staged draft still works).
  agentsPaused      Boolean                @default(false)
  entitlementCache  Json? // offline/dedicated only; null on shared SaaS
  syncedAt          DateTime               @default(now())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  memberships       Membership[]
  mailboxAccounts   MailboxAccount[]
  emailMessages     EmailMessage[]
  smsAccounts       SmsAccount[]
  smsMessages       SmsMessage[]
  agentInboxItems   AgentInboxItem[]
  agents            Agent[]
  agentMailboxes    AgentMailbox[]
  agentActionEvents AgentActionEvent[]
  provisioningPolicy   ProvisioningPolicy?
  provisioningRequests MailboxProvisioningRequest[]
  cleanupBatches    CleanupBatch[]
  engagementEvents  EmailEngagementEvent[]
  threadDispositions ThreadDisposition[]
  senderPolicies     SenderPolicy[]

  @@index([slug])
  @@index([status])
  @@map("workspaces")
}

model Membership {
  userKey     String // == User.keycloakId == uchub sub
  workspaceId String
  role        WorkspaceRole    @default(MEMBER)
  status      MembershipStatus @default(ACTIVE)
  isDefault   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userKey, workspaceId])
  @@index([userKey])
  @@index([workspaceId])
  @@map("memberships")
}

// ============================================================
// IDENTITY
// ============================================================
//
// The SSO-linked user. NOT workspace-scoped (SUITE-IDENTITY §2: User is
// a global identity; the Membership row is the tenancy boundary). A valid
// uchub token JIT-provisions this row (gated by the access list), but it
// grants ZERO workspace access until an explicit Membership exists (§D5).
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  username    String    @unique
  firstName   String    @default("")
  lastName    String    @default("")
  keycloakId  String?   @unique // == uchub sub once SSO-linked; the Membership.userKey
  kcRefreshTokenEnc String?
  kcRefreshUpdatedAt DateTime?
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([keycloakId])
  @@map("users")
}

// ============================================================
// MAILBOX ACCOUNT (Email-Ops OWNS this — tenant-scoped)
// ============================================================
//
// The per-workspace binding to a Stalwart mailbox account (the IMAP/JMAP
// login Email-Ops fronts for THIS workspace). Email-Ops federates the engine:
// Stalwart holds the actual mailbox; this row is just the addressing/credential
// reference + the default outbound identity, scoped to the workspace.
//
// We store NO password in plaintext: the secret is referenced indirectly
// (`secretRef` — a key into the node's secret store / env), so a DB read never
// leaks a mailbox credential. The host/port/protocol describe how to reach the
// Stalwart node for this account.
//
// RLS-fenced on workspaceId: a no-GUC read returns zero rows (fail-closed), and
// a write into another workspace is blocked by the WITH CHECK. ENABLE + FORCE.
model MailboxAccount {
  id           String   @id @default(uuid())
  workspaceId  String
  // The mailbox email address this account fronts (the workspace's deliverable
  // identity for sends; the IMAP/JMAP login user).
  emailAddress String
  // The display name to put on outbound From headers (optional).
  displayName  String?
  // Transport reachability to the Stalwart node (host:port). When null, the
  // global STALWART_* env config is used (single-tenant dogfood).
  imapHost     String?
  imapPort     Int?
  jmapUrl      String?
  smtpHost     String?
  smtpPort     Int?
  // Indirect credential reference — a key into the node secret store / env,
  // NEVER the secret itself. Email-Ops resolves it at connect time.
  secretRef    String?
  // Whether this is the workspace's default outbound mailbox (one per workspace).
  isDefault    Boolean  @default(false)
  // Whether transactional sends from this account should route via Postmark
  // (the high-rep lane) rather than Stalwart SMTP (per the suite comms lanes).
  postmarkLane Boolean  @default(true)
  active       Boolean  @default(true)
  // The PRINCIPAL behind this mailbox (command-center plane). Pre-existing rows
  // default SHARED (the workspace's deliverable identity, no single owner) =
  // back-compat, no data fixup. ownerKey: HUMAN→User.keycloakId / AGENT→Agent.key
  // / SHARED→null (soft reference). `kind` is a cheap denorm of ownerKind for the
  // grouped mailbox view. provisionState is honest: REGISTERED until the engine
  // mints the real account.
  ownerKind      MailboxOwnerKind      @default(SHARED)
  ownerKey       String?
  kind           String                @default("shared")
  provisionState MailboxProvisionState @default(REGISTERED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentMailboxes AgentMailbox[]

  // One mailbox identity per address per workspace.
  @@unique([workspaceId, emailAddress])
  @@index([workspaceId])
  @@index([workspaceId, isDefault])
  // "my inboxes" / "agent X's inboxes" / "shared boxes".
  @@index([workspaceId, ownerKind, ownerKey])
  @@map("mailbox_accounts")
}

// ============================================================
// EMAIL MESSAGE (Email-Ops OWNS this — tenant-scoped; the SoR)
// ============================================================
//
// The system-of-record row for every OUTBOUND message Email-Ops created (a send
// or a drafted agent-inbox approval), plus the thin index of a message's place
// in a thread. Email-Ops is the SoR for the message it initiated; the live
// thread/message bodies of RECEIVED mail live in Stalwart and are federated at
// read time (never stored here — we keep a snippet/preview only, mirroring the
// federate-don't-fork rule the cockpit holds toward us).
//
// IDEMPOTENCY (the contract): the compose tool is idempotent on
//   (workspaceId, externalSource, externalRef)
// so a retry from the cockpit never double-sends — the unique index enforces it
// and the tool returns the EXISTING row on a repeat.
//
// `contactId` is the federated Contact-Ops contact id this message is to/from
// (a thin reference; never a copy of the contact record). `threadId` is the
// JMAP/Stalwart thread id (or a synthesized one for a brand-new outbound).
//
// RLS-fenced on workspaceId exactly like the other scoped tables. ENABLE +
// FORCE, identical policy. A no-GUC read returns zero rows (fail-closed).
model EmailMessage {
  id                String             @id @default(uuid())
  workspaceId       String
  // The mailbox account this message belongs to (the workspace's identity).
  mailboxAccountId  String?
  // The federated Contact-Ops contact id this message is to/from (thin
  // reference; the contact record is NEVER copied — golden rule).
  contactId         String?
  // The thread the message belongs to (JMAP/Stalwart thread id, or synthesized
  // for a new outbound thread). Opaque to the cockpit.
  threadId          String?
  // The deterministic idempotency tuple the compose tool is idempotent on.
  // externalSource is the originating app ('customer-ops' for cockpit-initiated
  // sends); externalRef is the caller's deterministic key.
  externalSource    String?
  externalRef       String?
  mode              EmailMode          @default(SEND)
  status            EmailMessageStatus @default(QUEUED)
  direction         EmailDirection     @default(SENT)
  // Addressing + subject (kept for list rendering; the FULL body lives in
  // Stalwart for received mail — we keep the composed body of outbound mail
  // we initiated so the agent-inbox can render it for approval).
  fromAddress       String?
  toAddress         String?
  subject           String?
  // The composed plain-text body (outbound we initiated). A PREVIEW/snippet of
  // received mail is in `preview`; full received bodies stay in Stalwart.
  body              String?
  preview           String?
  // Inbound spam classification stamped by the SpamPort once the mail engine
  // produces a verdict (e.g. an rspamd/SpamAssassin score + a normalized verdict
  // 'clean'|'spam'|'unsure'). NULL until the engine is live (honest — no fiction
  // while dormant). The app-side Junk FOLDER is MessageDisposition.SPAM on the
  // thread; this is the raw engine signal that may drive that triage.
  spamScore         Float?
  spamVerdict       String?
  // If this message is a reply, the thread it replied within (for threading).
  inReplyToThreadId String?
  // The provider message id once delivery is handed off (Stalwart/Postmark id).
  // This is ALSO the key the inbound engagement webhook (Part A) resolves a
  // Postmark `MessageID` back to: provider event → this row → its workspaceId.
  // The resolve is a MINIMAL privileged (RLS-bypass) id→workspace lookup; the
  // actual status mutation then runs inside withWorkspace(resolvedWorkspaceId).
  providerMessageId String?
  // Attribution + provenance.
  actorUcUid        String?
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentInbox       AgentInboxItem?
  engagementEvents EmailEngagementEvent[]

  // The idempotency tuple is unique per workspace (partial on the non-null
  // source/ref — see the migration's partial unique index for the NULL case).
  @@unique([workspaceId, externalSource, externalRef])
  // The webhook resolves provider→row by providerMessageId; index it so the
  // privileged id→workspace lookup is a single-row hit (provider ids are unique
  // in practice; we don't UNIQUE it because a NULL is allowed pre-send).
  @@index([providerMessageId])
  @@index([workspaceId])
  @@index([workspaceId, contactId, createdAt])
  @@index([workspaceId, threadId])
  @@index([workspaceId, status])
  @@map("email_messages")
}

// ============================================================
// THREAD DISPOSITION (Email-Ops OWNS this — tenant-scoped; the folder overlay)
// ============================================================
//
// The app-layer folder placement of a thread, kept as a thin OVERLAY (one row
// per moved thread) merged over the federated mailbox at read time — never a
// fork of the engine's mailbox state. Absence of a row == INBOX. This is the
// model behind Inbox / Archive / Spam / Trash navigation + the "mark as spam /
// not spam / archive / trash" triage actions. RLS-fenced on workspaceId (ENABLE
// + FORCE, identical workspace_isolation policy). A no-GUC read returns zero
// rows (fail-closed).
model ThreadDisposition {
  id            String             @id @default(uuid())
  workspaceId   String
  // The JMAP/Stalwart (or synthesized) thread id this disposition overlays. A
  // string, NOT a FK to email_messages: received mail has no SoR row, so the
  // overlay is intentionally decoupled from the message rows it folders.
  threadId      String
  disposition   MessageDisposition @default(INBOX)
  // Light provenance: who/what last filed it (a human ucUid or an agent key).
  setByUcUid    String?
  setByAgentKey String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One disposition per thread per workspace (the latest triage wins).
  @@unique([workspaceId, threadId])
  @@index([workspaceId, disposition])
  @@map("thread_dispositions")
}

// ============================================================
// SENDER POLICY (Email-Ops OWNS this — tenant-scoped; block/allow list)
// ============================================================
//
// The per-workspace sender block/allow list. The app enforces it on display +
// triage today and FEEDS it to the mail engine's inbound filter once live (the
// engine is the real gate; this is the policy the app teaches it). RLS-fenced on
// workspaceId exactly like the rest.
model SenderPolicy {
  id            String            @id @default(uuid())
  workspaceId   String
  scope         SenderPolicyScope
  // The normalized (lowercased) match value: a full address for ADDRESS scope,
  // a bare domain (no leading '@') for DOMAIN scope.
  pattern       String
  kind          SenderPolicyKind
  reason        String?
  setByUcUid    String?
  setByAgentKey String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // One verdict per (scope,pattern) per workspace; flipping BLOCK↔ALLOW updates it.
  @@unique([workspaceId, scope, pattern])
  @@index([workspaceId, kind])
  @@map("sender_policies")
}

// ============================================================
// AGENT INBOX (Email-Ops OWNS this — tenant-scoped; the approval queue)
// ============================================================
//
// The human-in-the-loop approval surface (SUITE-ARCHITECTURE-MAP §2: Email-Ops
// owns "agent inboxes — the human-in-the-loop approval surface for agent mail").
// When a compose lands with mode=draft, a row lands HERE in state PENDING,
// pointing at the staged EmailMessage. An APPROVE action transitions the item to
// APPROVED and hands the message to the send lane; a REJECT marks it REJECTED
// and the message never leaves.
//
// This is the brief's "tenant-scoped (RLS) queue of agent-drafted messages
// awaiting human approval before send". RLS-fenced on workspaceId exactly like
// the other scoped tables. ENABLE + FORCE, identical policy. A no-GUC read
// returns zero rows (fail-closed) — an agent draft is never visible across the
// tenant fence.
model AgentInboxItem {
  id              String          @id @default(uuid())
  workspaceId     String
  // The staged outbound EMAIL message awaiting approval (1:1; null for SMS items).
  messageId       String?         @unique
  // The staged outbound SMS message awaiting approval (1:1; null for email items).
  // Additive: an SMS draft sets this and leaves messageId null. The existing email
  // path is untouched.
  smsMessageId    String?         @unique
  kind            AgentInboxKind  @default(EMAIL)
  payload         Json?
  state           AgentInboxState @default(PENDING)
  // Which agent/source drafted this (provenance; 'customer-ops' for a cockpit
  // agent draft).
  draftedBy       String?
  // A one-line summary the queue renders without opening the full body.
  summary         String?
  // Who approved/rejected it + when (the human-in-the-loop attribution).
  reviewedByUcUid String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   EmailMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  smsMessage SmsMessage?  @relation(fields: [smsMessageId], references: [id], onDelete: Cascade)
  cleanupBatch CleanupBatch?

  @@index([workspaceId])
  // The queue reads pending items newest-first.
  @@index([workspaceId, state, createdAt])
  @@map("agent_inbox_items")
}

// ============================================================
// SMS ACCOUNT (Email-Ops OWNS this — tenant-scoped; the shared-line identity)
// ============================================================
//
// The SMS analogue of MailboxAccount: a workspace's outbound SMS identity (a
// Twilio number for the enterprise/shared-line scope). RLS-fenced on workspaceId
// exactly like mailbox_accounts. `secretRef` points at the provider credential in
// the secret store (never the secret itself). ownerKind/ownerKey mirror the
// mailbox ownership model so an agent or a human can "own" a line.
model SmsAccount {
  id             String                @id @default(uuid())
  workspaceId    String
  phoneNumber    String // E.164, e.g. +15551234567
  displayName    String?
  secretRef      String?
  isDefault      Boolean               @default(false)
  active         Boolean               @default(true)
  ownerKind      MailboxOwnerKind      @default(SHARED)
  ownerKey       String?
  provisionState MailboxProvisionState @default(REGISTERED)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  SmsMessage[]

  @@unique([workspaceId, phoneNumber])
  @@index([workspaceId])
  @@index([workspaceId, isDefault])
  @@index([workspaceId, ownerKind, ownerKey])
  @@map("sms_accounts")
}

// ============================================================
// SMS MESSAGE (Email-Ops OWNS this — tenant-scoped; the SoR)
// ============================================================
//
// The system-of-record row for every SMS Email-Ops created (a send or an
// approved agent-inbox draft) AND for inbound SMS recorded by the Twilio webhook.
// The SMS analogue of EmailMessage — same idempotency tuple, same provider-id
// resolve key, same RLS fence. SMS has no server-side thread store, so the body
// is the SoR (there is no federate-from-engine read like Stalwart for email).
model SmsMessage {
  id                String            @id @default(uuid())
  workspaceId       String
  smsAccountId      String?
  // The federated Contact-Ops contact id this message is to/from (thin reference).
  contactId         String?
  threadId          String?
  // Idempotency tuple (workspaceId, externalSource, externalRef) — the compose
  // path is idempotent on it, and the inbound webhook is idempotent on the
  // provider id (providerMessageId).
  externalSource    String?
  externalRef       String?
  mode              SmsMode           @default(SEND)
  status            SmsDeliveryStatus @default(QUEUED)
  // 'SENT' | 'RECEIVED' | 'DRAFT' (TEXT, like the rest of the channel-direction).
  direction         String            @default("SENT")
  fromPhoneNumber   String?
  toPhoneNumber     String?
  body              String?
  preview           String?
  // The provider message id (Twilio MessageSid) — the inbound/status webhook
  // resolves provider→row by this, exactly like email's providerMessageId.
  providerMessageId String?
  actorUcUid        String?
  sentAt            DateTime?
  receivedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  smsAccount SmsAccount?     @relation(fields: [smsAccountId], references: [id], onDelete: SetNull)
  agentInbox AgentInboxItem?

  @@unique([workspaceId, externalSource, externalRef])
  @@index([providerMessageId])
  @@index([workspaceId])
  @@index([workspaceId, contactId, createdAt])
  @@index([workspaceId, threadId])
  @@index([workspaceId, status])
  @@map("sms_messages")
}

// ============================================================
// AGENT (Email-Ops OWNS this — tenant-scoped; the agent registry)
// ============================================================
//
// A first-class, workspace-scoped identity for each agent that drafts/sends mail
// (Customer-Ops, Email-Ops Agent, a per-platform persona, ...). This is the
// registry behind the "Agents" view + the autonomy dial — the second pillar of
// the Agent Email Command Center, alongside the agent-inbox approval queue.
//
// `key` is the STABLE provenance slug that supersedes the free-text
// AgentInboxItem.draftedBy ('customer-ops', 'email-ops-agent', ...): unique per
// workspace, it's how a queue item is attributed back to a registered agent.
// `mailboxAccountId` is a SOFT reference to the MailboxAccount the agent sends
// from (no DB FK, matching EmailMessage.mailboxAccountId — the RLS-fenced mailbox
// table is resolved in app code, not cross-referenced). `autonomyLevel` is the
// dial; `recipientPolicy` is an optional per-recipient-class scoping (JSON-on-row,
// matching the payload/criteria convention).
//
// RLS-fenced on workspaceId exactly like the other scoped tables. ENABLE + FORCE,
// identical workspace_isolation policy. A no-GUC read returns zero rows.
model Agent {
  id               String             @id @default(uuid())
  workspaceId      String
  key              String
  displayName      String
  description      String?
  mailboxAccountId String?
  autonomyLevel    AgentAutonomyLevel @default(L1_APPROVE_TO_SEND)
  recipientPolicy  Json?
  active           Boolean            @default(true)
  // Org-chart hierarchy (a thin denorm of the Brigade fleet — Email-Ops federates
  // the identity + governance; Brigade owns the runtime/loop/inter-agent tasking).
  // managerAgentKey is a SOFT ref by Agent.key (the parent may be created later /
  // reorg churn → a dangling ref renders "unmanaged", can't break a migration).
  tier             AgentTier          @default(UNSPECIFIED)
  managerAgentKey  String?
  brigadeAgentId   String?
  // Per-agent pause: stops THIS agent's compose/send (distinct from the
  // workspace-wide kill switch, which stops the whole fleet).
  paused           Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // The mailboxes this agent may act through (multi-mailbox). mailboxAccountId
  // above is the denormalized cache of the isPrimary binding's mailbox.
  mailboxes AgentMailbox[]

  // One agent identity per key per workspace (the stable provenance slug).
  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@index([workspaceId, active])
  // "list an agent's reports" / org-chart render; tier-scoped policy + pause sweep.
  @@index([workspaceId, managerAgentKey])
  @@index([workspaceId, tier])
  @@map("agents")
}

// ============================================================
// AGENT MAILBOX (Email-Ops OWNS this — tenant-scoped; the multi-mailbox join)
// ============================================================
//
// Which mailboxes an agent may ACT THROUGH, with what access, and which is its
// default From (isPrimary). Distinct from ownership (MailboxAccount.ownerKind):
// a shared sales@ is owned by no one yet several agents send from it; a delegate
// agent reads a human's inbox it doesn't own. REAL FKs (not soft) — a junction
// whose whole purpose is referential integrity + cascade between two same-fence
// tables. RLS-fenced on workspaceId like every scoped table.
model AgentMailbox {
  id               String             @id @default(uuid())
  workspaceId      String
  agentId          String
  mailboxAccountId String
  access           MailboxAccessLevel @default(SEND)
  // The agent's default From (exactly one TRUE per agent, app-enforced like
  // MailboxAccount.isDefault).
  isPrimary        Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  mailbox   MailboxAccount @relation(fields: [mailboxAccountId], references: [id], onDelete: Cascade)

  @@unique([agentId, mailboxAccountId])
  @@index([workspaceId])
  @@index([workspaceId, agentId])
  @@index([workspaceId, mailboxAccountId])
  @@map("agent_mailboxes")
}

// ============================================================
// AGENT ACTION EVENT (Email-Ops OWNS this — tenant-scoped; the activity/audit log)
// ============================================================
//
// The append-only audit substrate behind the agent-mail ACTIVITY FEED and the
// "autonomous-with-audit" guarantee: one row per governance-relevant action (an
// L2 autonomous send, a staged draft, a human approve/reject, a kill-switch
// toggle). `agentKey` is the acting agent's provenance slug (the autonomous
// actor); `actorUcUid` is the acting human (approve/reject/pause). `messageId`
// links the email when applicable. Read newest-first for the feed.
//
// RLS-fenced on workspaceId exactly like the other scoped tables. ENABLE + FORCE,
// identical workspace_isolation policy. A no-GUC read returns zero rows.
model AgentActionEvent {
  id          String          @id @default(uuid())
  workspaceId String
  kind        AgentActionKind
  agentKey    String?
  // Delegation provenance: when agent A acts because manager/peer B tasked it,
  // this is B's key. agentKey stays the ACTING identity; null = self-initiated.
  onBehalfOfAgentKey String?
  messageId   String?
  actorUcUid  String?
  detail      String?
  createdAt   DateTime        @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  // The feed reads events newest-first.
  @@index([workspaceId, createdAt])
  @@map("agent_action_events")
}

// ============================================================
// PROVISIONING POLICY (Email-Ops OWNS this — per-workspace RBAC control surface)
// ============================================================
//
// Who may create/edit human mailboxes, agent mailboxes (send identities), and
// agents — the founder's flexible dials. One row per workspace (1:1); when absent
// the code DEFAULT_PROVISIONING_POLICY applies (inert until a row is written).
// Typed (not JSON) — a fixed control surface on the hot path + edited by an admin
// UI. RLS-fenced on workspaceId like the scoped tables (defense-in-depth, even
// though the @id IS the workspaceId); reads/writes go through withWorkspace.
model ProvisioningPolicy {
  workspaceId                String           @id
  humanMailboxCreateMode     ProvisioningMode @default(MANAGER)
  humanMailboxEditMode       ProvisioningMode @default(MANAGER)
  // An agent's send identity is higher-trust — default ADMIN_ONLY.
  agentMailboxCreateMode     ProvisioningMode @default(ADMIN_ONLY)
  agentMailboxEditMode       ProvisioningMode @default(ADMIN_ONLY)
  agentCreateMode            ProvisioningMode @default(MANAGER)
  agentEditMode              ProvisioningMode @default(MANAGER)
  // The rung that approves an APPROVAL-mode request.
  approverMinRole            WorkspaceRole    @default(ADMIN)
  // May a MEMBER create their OWN human mailbox regardless of the mode above.
  allowSelfServiceOwnMailbox Boolean          @default(false)
  maxMailboxesPerWorkspace   Int?
  maxAgentsPerWorkspace      Int?
  updatedByUcUid             String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("provisioning_policies")
}

// ============================================================
// MAILBOX PROVISIONING REQUEST (Email-Ops OWNS this — tenant-scoped; approval queue)
// ============================================================
//
// An APPROVAL-mode (or above-the-caller's-rung) create/edit lands here PENDING. On
// approve, the validated `payload` is REPLAYED through the SAME service method the
// direct path uses (one write path). Separate from AgentInboxItem: a different
// gate (a role rung, not a comms SKU), no message body, APPLIED/FAILED terminal
// (the engine apply can defer while dormant). RLS-fenced on workspaceId.
model MailboxProvisioningRequest {
  id          String                   @id @default(uuid())
  workspaceId String
  kind        ProvisionableKind
  action      String                   @default("CREATE")
  state       ProvisioningRequestState @default(PENDING)
  // The validated create/edit payload, replayed through the canonical service.
  payload     Json
  // The MailboxAccount/Agent id for an UPDATE (null for CREATE).
  targetId            String?
  summary             String?
  requestedByUcUid    String?
  requestedByAgentKey String?
  reviewedByUcUid     String?
  reviewedAt          DateTime?
  reviewNote          String?
  // Engine-gated: the created/updated id once applied, + why an apply deferred.
  appliedRefId  String?
  appliedAt     DateTime?
  failureReason String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, state, createdAt])
  @@map("mailbox_provisioning_requests")
}

// ============================================================
// CLEANUP BATCH (Email-Ops OWNS this — tenant-scoped; the cleanup audit log)
// ============================================================
//
// One audit row per cleanup/organize/unsubscribe/undo action. The agent inbox
// stages approval requests; this table persists the approved/executed batch and
// carries the plan/result payload the UI renders in the review rail.
model CleanupBatch {
  id               String            @id @default(uuid())
  workspaceId      String
  provider         String
  action           CleanupActionKind
  mode             String
  state            CleanupBatchState @default(PENDING)
  criteria         Json?
  plan             Json
  result           Json?
  backupRef        String?
  backupVerified   Boolean           @default(false)
  archiveBucket    String?
  archiveKey       String?
  archiveBytes     BigInt?
  archiveSha256    String?
  archiveExpiresAt DateTime?
  archiveRetained  Boolean           @default(false)
  restoredAt       DateTime?
  requestedByUcUid String?
  approvedByUcUid  String?
  agentInboxItemId String? @unique
  summary          String?
  params           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  completedAt      DateTime?
  undoneAt         DateTime?

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agentInboxItem AgentInboxItem? @relation(fields: [agentInboxItemId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, state, createdAt])
  @@map("cleanup_batches")
}

// ============================================================
// EMAIL ENGAGEMENT EVENT (Email-Ops OWNS this — tenant-scoped; the capture log)
// ============================================================
//
// PHASE 2 (this layer): the durable, idempotent, auditable capture of every
// delivery/engagement signal the mail engine reports for a message Email-Ops
// sent. Postmark is the first provider; the inbound webhook (Part A) maps each
// Postmark record (Delivery|Open|Click|Bounce|SpamComplaint|SubscriptionChange)
// → one row here, AND advances the owning EmailMessage's status idempotently
// (never regressing a later status). This is the table the existing PULL
// federation (Customer-Ops over MCP, via the thread/last_message_at views)
// surfaces engagement through — Email-Ops CAPTURES + PERSISTS; the cockpit
// PULLS. There is deliberately NO push-to-Customer-Ops seam.
//
// IDEMPOTENCY (the contract): UNIQUE on (workspaceId, provider, providerEventId)
// so a webhook re-delivery is a NO-OP — the second insert hits the unique index
// and the handler treats it as already-seen (no duplicate row, no double status
// advance). `providerEventId` is the provider's own dedupe key for the record
// (Postmark's per-record id; when a record type carries none we synthesize a
// deterministic one from MessageID + recordType + occurredAt so re-delivery
// still dedupes).
//
// `normalizedKind` is the suite's normalized engagement vocabulary
// (opened|clicked|bounced|unsubscribed; REPLIED is reserved — see the enum) when
// the record maps to one, else NULL (e.g. a raw Delivery is a status signal, not
// one of the 5 engagement kinds). `raw` keeps the verbatim provider payload for
// audit/replay; we never depend on it at read time.
//
// RLS-fenced on workspaceId exactly like the other scoped tables. ENABLE +
// FORCE, identical workspace_isolation policy. A no-GUC read returns zero rows
// (fail-closed) — an engagement signal is never visible across the tenant fence.
// The webhook arrives workspace-agnostic, so the write is performed INSIDE
// withWorkspace(resolvedWorkspaceId) after a minimal privileged id→workspace
// resolve; the WITH CHECK guarantees the row can only land in the resolved
// workspace.
model EmailEngagementEvent {
  id              String               @id @default(uuid())
  workspaceId     String
  // The message this signal is about (the SoR row Email-Ops sent). Thin FK; the
  // resolve from a provider MessageID → this id → its workspaceId is the
  // privileged id-only step the webhook performs before scoping the write.
  emailMessageId  String
  // The reporting provider. 'postmark' today; the column generalizes to other
  // engines (Stalwart bounce, etc.) without a schema change.
  provider        String               @default("postmark")
  // The provider's own dedupe key for THIS record (the idempotency anchor).
  providerEventId String
  // The raw provider record type, verbatim (Postmark RecordType:
  // Delivery|Open|Click|Bounce|SpamComplaint|SubscriptionChange). Kept raw so a
  // new record type is auditable even before it's mapped.
  recordType      String
  // The normalized suite engagement kind (opened|clicked|bounced|unsubscribed),
  // or NULL for a non-engagement signal (a bare Delivery). The WIRE value the
  // pull-federation reads is this enum lowercased.
  normalizedKind  EmailEngagementKind?
  // When the engine says the event occurred (provider timestamp), defaulting to
  // capture time when the record carries none.
  occurredAt      DateTime             @default(now())
  // The verbatim provider payload (audit / replay). Never read at query time.
  raw             Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  message   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  // Re-delivery is a no-op: one row per provider event per workspace.
  @@unique([workspaceId, provider, providerEventId])
  @@index([workspaceId])
  // The per-message engagement timeline (newest-first reads).
  @@index([workspaceId, emailMessageId, occurredAt])
  @@map("email_engagement_events")
}

// NOTE: The Workspace↔MailboxAccount / Workspace↔EmailMessage /
// Workspace↔AgentInboxItem / Workspace↔EmailEngagementEvent relations are
// declared here to satisfy Prisma's relation requirement. They do NOT make
// Workspace a tenant-scoped table — Workspace is the tenancy CONTROL table (not
// RLS-fenced); MailboxAccount + EmailMessage + AgentInboxItem +
// EmailEngagementEvent are the scoped projections (RLS-fenced by the migrations).
