# Shared secret required by every endpoint except POST /health.
ENGINE_SHARED_SECRET=

# Gmail OAuth client ID passed through to the Gmail provider factory.
GOOGLE_CLIENT_ID=

# Gmail OAuth client secret passed through to the Gmail provider factory.
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth client ID passed through to the Microsoft provider factory.
MICROSOFT_CLIENT_ID=

# Microsoft OAuth client secret passed through to the Microsoft provider factory.
MICROSOFT_CLIENT_SECRET=

# Microsoft tenant ID for MSAL; defaults to "common".
MICROSOFT_TENANT_ID=common

# LiteLLM gateway base URL, e.g. https://litellm.example.com/v1
LITELLM_BASE_URL=

# LiteLLM API key used as the OpenAI SDK key.
LITELLM_API_KEY=

# Default local/open-weight model for AI calls.
LITELLM_MODEL=local/qwen3.5-9b

# Frontier fallback model used when the primary model fails.
LITELLM_FRONTIER_MODEL=

# Maximum tokens for AI responses.
MAX_TOKENS=2048

# Sampling temperature for AI responses.
TEMPERATURE=0.7
