# Email-Ops local self-host profile. Copy to .env.selfhost and replace the
# CHANGE_ME values, or export generated values before running Compose.

POSTGRES_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d

CORS_ORIGIN=http://127.0.0.1:3000
FRONTEND_URL=http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false

EMAIL_OPS_TENANCY_ENABLED=true
DEFAULT_WORKSPACE_ID=0190a000-7e57-7000-8000-00000000e001
EMAIL_OPS_ACCESS_LIST=
UC_ENTITLEMENT_MODE=open

BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
BOOTSTRAP_WORKSPACE_SLUG=email-ops-selfhost
BOOTSTRAP_WORKSPACE_NAME=Email-Ops

# Hosted SSO/federation is disabled for this profile. Leave these blank.
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CALLBACK_URL=
BRIGADE_TRUSTED_ISSUERS=
BRIGADE_EXPECTED_AUDIENCE=email-ops

# MAIL_ENGINE, JAMES_*, POSTMARK_*, and CLEANER_ENGINE_* are intentionally
# unset. Set those variables only when adding the corresponding optional service.
