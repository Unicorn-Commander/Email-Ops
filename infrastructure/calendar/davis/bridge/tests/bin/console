#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * A fixture for the bridge protocol tests. It prints the Davis 5.6.2 output exactly as captured from the live server
 * on 2026-10-26: Symfony-style tables and definition lists (dashed borders, space-padded cells, no pipes) and
 * " [OK]" / " [ERROR]" / " ! [NOTE]" / " [WARNING]" blocks. All ids and secrets are generated at runtime.
 */

$statePath = getenv('FAKE_CONSOLE_STATE');
if (!is_string($statePath) || $statePath === '') {
    fwrite(STDERR, "missing fixture state\n");
    exit(2);
}

$state = is_file($statePath) ? json_decode(file_get_contents($statePath) ?: '', true) : null;
if (!is_array($state)) {
    $state = ['users' => [], 'keys' => [], 'create_count' => 0];
}
$state['users'] ??= [];
$state['keys'] ??= [];
$state['create_count'] ??= 0;

$args = array_values(array_filter(array_slice($argv, 1), static fn (string $arg): bool => !in_array($arg, ['--no-interaction', '--no-ansi'], true)));
$command = $args[0] ?? '';

$save = static function () use (&$state, $statePath): void {
    file_put_contents($statePath, json_encode($state, JSON_THROW_ON_ERROR));
};

// Symfony's block style: a blank line, the padded message (80 columns), a blank line.
$block = static function (string $prefix, string $message): void {
    echo "\n".str_pad(' '.$prefix.' '.$message, 80)."\n\n";
};

// Symfony's table style for SymfonyStyle: " " + per column (" " + cell + " ") joined by " ", borders of dashes.
$table = static function (?array $headers, array $rows): void {
    $all = $headers === null ? $rows : array_merge([$headers], $rows);
    $widths = [];
    foreach ($all as $row) {
        foreach (array_values($row) as $index => $cell) {
            $widths[$index] = max($widths[$index] ?? 0, mb_strlen((string) $cell));
        }
    }
    $border = ' '.implode(' ', array_map(static fn (int $width): string => str_repeat('-', $width + 2), $widths)).' ';
    $line = static function (array $row) use ($widths): string {
        $cells = [];
        foreach (array_values($row) as $index => $cell) {
            $cells[] = ' '.$cell.str_repeat(' ', $widths[$index] - mb_strlen((string) $cell)).' ';
        }
        return ' '.implode(' ', $cells).' ';
    };
    echo $border."\n";
    if ($headers !== null) {
        echo $line($headers)."\n".$border."\n";
    }
    foreach ($rows as $row) {
        echo $line($row)."\n";
    }
    echo $border."\n";
};

$option = static function (array $args, array $names): ?string {
    for ($i = 1; $i < count($args) - 1; $i++) {
        if (in_array($args[$i], $names, true)) {
            return $args[$i + 1];
        }
    }
    return null;
};

if ($command === 'davis:app-key:create') {
    $name = $args[1] ?? '';
    $login = (string) $option($args, ['-u', '--user']);
    $expiresAt = $option($args, ['--expires-at']);
    if (!in_array($login, $state['users'], true)) {
        $block('[ERROR]', "These users do not exist: {$login}.");
        exit(2);
    }

    $state['create_count']++;
    $appId = 'app_'.substr(hash('sha256', $name.'|'.$login.'|'.$state['create_count']), 0, 24);
    $secret = bin2hex(random_bytes(32));
    $state['keys'][] = [
        'name' => $name,
        'app_id' => $appId,
        'scope' => [$login],
        'created' => gmdate('Y-m-d H:i'),
        'last_used' => 'never',
        'used_as' => 'nobody',
        // Davis stores an expiry in revokedAt, so a live expiring key lists as "expires <date>".
        'status' => $expiresAt === null ? 'active' : 'expires '.(new DateTimeImmutable($expiresAt))->format('Y-m-d H:i'),
    ];
    $save();
    echo "\n";
    $table(null, [['Name', $name], ['App id', $appId], ['Secret', $secret], ['Scope', $login], ['Basic username', '<login>*'.$appId]]);
    echo "\n";
    $block('[WARNING]', 'The secret is not stored and will not be shown again.');
    exit(0);
}

if ($command === 'davis:app-key:list') {
    if ($state['keys'] === []) {
        $block('! [NOTE]', 'No app key yet.');
        exit(0);
    }
    $rows = array_map(static fn (array $key): array => [
        $key['name'], $key['app_id'], implode(', ', $key['scope']), $key['created'], $key['last_used'], $key['used_as'], $key['status'],
    ], array_reverse($state['keys']));
    $table(['Name', 'App id', 'Scope', 'Created', 'Last used', 'Used as', 'Status'], $rows);
    exit(0);
}

if ($command === 'davis:app-key:revoke') {
    $appId = $args[1] ?? '';
    foreach ($state['keys'] as &$key) {
        if ($key['app_id'] !== $appId) {
            continue;
        }
        if (str_starts_with($key['status'], 'revoked ')) {
            $block('! [NOTE]', "{$appId} was already revoked on ".substr($key['status'], 8).'.');
        } else {
            $key['status'] = 'revoked '.gmdate('Y-m-d H:i');
            $block('[OK]', "Revoked {$appId}.");
            $save();
        }
        unset($key);
        exit(0);
    }
    unset($key);
    $block('[ERROR]', "No app key with the app id {$appId}.");
    exit(1);
}

fwrite(STDERR, "unknown fixture command\n");
exit(2);
