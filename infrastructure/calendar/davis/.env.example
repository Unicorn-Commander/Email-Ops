# The Symfony environment. Davis must stay in production mode on your-mail-host.
APP_ENV=prod

# Generate a fresh application secret on the host; never commit the result.
APP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# The Davis PostgreSQL database name used by the compose service.
DAVIS_POSTGRES_DB=davis

# The Davis PostgreSQL login used by the compose service and backups.
DAVIS_POSTGRES_USER=davis

# The Davis PostgreSQL password; use a separate strong value from James.
DAVIS_POSTGRES_PASSWORD=CHANGE_ME_DAVIS_POSTGRES_PASSWORD

# Davis's database backend; the default deployment is PostgreSQL.
DATABASE_DRIVER=postgresql

# Davis's PostgreSQL URL; the password component must be URI-encoded.
DATABASE_URL=postgresql://davis:REMOVED@davis-postgres:5432/davis?serverVersion=16&charset=utf8

# The externally created Docker network used by the James compose project.
JAMES_COMPOSE_NETWORK=james-prod_default

# The dashboard login name; this is separate from mailbox authentication.
ADMIN_LOGIN=calendar-admin

# Set a strong dashboard password; do not reuse an IMAP password.
ADMIN_PASSWORD=CHANGE_ME_DAVIS_ADMIN_PASSWORD

# Keep this realm stable after first use if legacy Davis password hashes exist.
AUTH_REALM=SabreDAV

# Authenticate DAV users against James IMAP, not a second Davis user store.
AUTH_METHOD=IMAP

# Use James's internal plain-IMAP listener on the shared Docker network.
IMAP_AUTH_URL=james-prod-app:143

# README-documented IMAP transport setting; false means plain IMAP on port 143.
IMAP_ENCRYPTION_METHOD=false

# Plain internal IMAP has no server certificate to validate.
IMAP_CERTIFICATE_VALIDATION=false

# Create the Davis account on a successful first IMAP login.
IMAP_AUTH_USER_AUTOCREATE=true

# Enable Davis app keys for mobile and service clients.
APP_KEYS_ENABLED=true

# Enable calendar resources.
CALDAV_ENABLED=true

# Enable contacts/address books as the suite's third DAV surface.
CARDDAV_ENABLED=true

# Disable the general WebDAV file tree for this calendar deployment.
WEBDAV_ENABLED=false

# Allow administrators to opt an individual calendar into public access.
PUBLIC_CALENDARS_ENABLED=true

# Requested suite-level timezone setting; Davis reads APP_TIMEZONE below.
TIMEZONE=America/New_York

# Davis v5.6.2's documented timezone variable.
APP_TIMEZONE=America/New_York

# Requested suite-level proxy setting; Davis reads SYMFONY_TRUSTED_PROXIES below.
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# Davis's documented Symfony forwarded-header trust setting.
SYMFONY_TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# Keep Davis's temporary WebDAV path inside the container filesystem.
WEBDAV_TMP_DIR=/tmp

# This path is unused while WEBDAV_ENABLED=false but is kept explicit.
WEBDAV_PUBLIC_DIR=/webdav/public

# Disable per-user WebDAV home directories.
WEBDAV_HOMES_DIR=

# SMTP DSN through James submission; encode username and password for a URI.
MAILER_DSN=smtp://calendar%40unicorncommander.ai:CHANGE_ME_URL_ENCODED_SMTP_PASSWORD@james-prod-app:587

# From-address for Davis scheduling and invitation messages.
INVITE_FROM_ADDRESS=calendar@unicorncommander.ai

# James's running Postgres container name for the nightly backup.
JAMES_POSTGRES_CONTAINER=james-prod-postgres

# Read the James database name from the deployed James compose environment.
JAMES_POSTGRES_DB=CHANGE_ME_READ_FROM_JAMES_COMPOSE

# Read the James database user from the deployed James compose environment.
JAMES_POSTGRES_USER=CHANGE_ME_READ_FROM_JAMES_COMPOSE

# Davis's running Postgres container name for the nightly backup.
DAVIS_POSTGRES_CONTAINER=davis-postgres

# Davis database name passed to pg_dump; keep it aligned with DAVIS_POSTGRES_DB.
DAVIS_POSTGRES_BACKUP_DB=davis

# Davis database user passed to pg_dump; keep it aligned with DAVIS_POSTGRES_USER.
DAVIS_POSTGRES_BACKUP_USER=davis

# Stable hostname prefix used in backup filenames.
BACKUP_HOST=your-mail-host

# Local destination for custom-format dumps.
BACKUP_DIR=/home/deploy/backups/mail-calendar

# Number of newest dumps retained locally for each database.
BACKUP_RETENTION_COUNT=14

# Optional rsync destination; leave empty until an off-box target is approved.
BACKUP_RSYNC_TARGET=

# First-issue certificate email; use a monitored address on the real host.
CERTBOT_EMAIL=admin@example.invalid

# Existing James certificate directory shared by renew-cert.sh and certbot.
LETSENCRYPT_DIR=/home/deploy/james-prod/letsencrypt

# Existing certbot wrapper path; override if the James checkout differs.
CERTBOT_BIN=/home/deploy/james-prod/certbot/certbot

# MariaDB fallback database name; only used with docker-compose.mariadb.yml.
DAVIS_MARIADB_DATABASE=davis

# MariaDB fallback application user; only used with the MariaDB override.
DAVIS_MARIADB_USER=davis

# MariaDB fallback application password; keep it distinct from PostgreSQL.
DAVIS_MARIADB_PASSWORD=CHANGE_ME_DAVIS_MARIADB_PASSWORD

# URI-encoded copy of the MariaDB password used in DATABASE_URL.
DAVIS_MARIADB_PASSWORD_URLENCODED=CHANGE_ME_URL_ENCODED_MARIADB_PASSWORD

# MariaDB root password used only to initialize the fallback container.
DAVIS_MARIADB_ROOT_PASSWORD=CHANGE_ME_DAVIS_MARIADB_ROOT_PASSWORD
