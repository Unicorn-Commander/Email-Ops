[Unit]
Description=Back up James and Davis mail/calendar databases
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=muut
Group=muut
WorkingDirectory=/home/deploy/Email-Ops/infrastructure/calendar/davis
EnvironmentFile=-/home/deploy/Email-Ops/infrastructure/calendar/davis/.env
ExecStart=/home/deploy/Email-Ops/infrastructure/calendar/davis/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/deploy/backups/mail-calendar
TimeoutStartSec=15min
